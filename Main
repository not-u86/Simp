#include <iostream>
#include <cmath>
#include <windows.h>

using namespace std;

// Функция для интегрирования
double f(double x)
{
    return exp(x);
}

// Метод средних прямоугольников
double middle(double a, double b, int n)
{
    double h = (b - a) / n;
    double sum = 0;

    for (int i = 0; i < n; i++)
    {
        double x = a + (i + 0.5) * h;
        sum += f(x);
    }

    return h * sum;
}

// Метод трапеций
double trapezoid(double a, double b, int n)
{
    double h = (b - a) / n;
    double sum = (f(a) + f(b)) / 2;

    for (int i = 1; i < n; i++)
    {
        double x = a + i * h;
        sum += f(x);
    }

    return h * sum;
}

// Метод Симпсона
double simpson(double a, double b, int n)
{
    double h = (b - a) / n;
    double sum = f(a) + f(b);

    for (int i = 1; i < n; i++)
    {
        double x = a + i * h;

        if (i % 2 == 0)
            sum += 2 * f(x);
        else
            sum += 4 * f(x);
    }

    return h / 3 * sum;
}

// Вычисление погрешности
double error(double exact, double result)
{
    double e = exact - result;

    if (e < 0)
        e = -e;

    return e;
}

int main()
{
    SetConsoleCP(CP_UTF8);
    SetConsoleOutputCP(CP_UTF8);

    double a = 0;
    double b = 1;

    // Точное значение интеграла
    double exact = exp(1) - exp(0);

    cout << "Численное интегрирование" << endl;
    cout << "Функция: e^x" << endl << endl;

    // Расчет для n = 4
    int n = 4;

    cout << "Количество отрезков: " << n << endl;

    double I1 = middle(a, b, n);
    double I2 = trapezoid(a, b, n);
    double I3 = simpson(a, b, n);

    cout << "Средние прямоугольники: " << I1 << endl;
    cout << "Погрешность: " << error(exact, I1) << endl;

    cout << "Метод трапеций: " << I2 << endl;
    cout << "Погрешность: " << error(exact, I2) << endl;

    cout << "Метод Симпсона: " << I3 << endl;
    cout << "Погрешность: " << error(exact, I3) << endl << endl;

    // Расчет для n = 8
    n = 8;

    cout << "Количество отрезков: " << n << endl;

    I1 = middle(a, b, n);
    I2 = trapezoid(a, b, n);
    I3 = simpson(a, b, n);

    cout << "Средние прямоугольники: " << I1 << endl;
    cout << "Погрешность: " << error(exact, I1) << endl;

    cout << "Метод трапеций: " << I2 << endl;
    cout << "Погрешность: " << error(exact, I2) << endl;

    cout << "Метод Симпсона: " << I3 << endl;
    cout << "Погрешность: " << error(exact, I3) << endl;

    return 0;
}
